<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <WheelSettingsSource Condition="'$(WheelSettingsSource)' == ''">../Plugin/Azurite/WheelSettingsControl.cs</WheelSettingsSource>
  </PropertyGroup>
  <ItemGroup><Compile Include="$(WheelSettingsSource)" Link="Production/WheelSettingsControl.cs" /></ItemGroup>
</Project>
