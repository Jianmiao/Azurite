<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <GallerySource Condition="'$(GallerySource)' == ''">../Plugin/Azurite/BackgroundGalleryLoadCulling.cs</GallerySource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(GallerySource)" Link="Production/BackgroundGalleryLoadCulling.cs" />
  </ItemGroup>
</Project>
