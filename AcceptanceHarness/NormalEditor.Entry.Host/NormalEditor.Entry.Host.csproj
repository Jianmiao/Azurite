    <Reference Include="Azurite.NormalEditor.Adapter.Host.PreparationOnly"><HintPath>../NormalEditor.Adapter.Host/bin/Release/net6.0/Azurite.NormalEditor.Adapter.Host.PreparationOnly.dll</HintPath></Reference>
    <Reference Include="Azurite.NormalEditor.Policy.PreparationOnly"><HintPath>../NormalEditor.Policy/bin/Release/net6.0/Azurite.NormalEditor.Policy.PreparationOnly.dll</HintPath></Reference>
    <Reference Include="Azurite.EditorIsolation.Policy.LabOnly"><HintPath>../EditorIsolation.Policy/bin/Release/net6.0/Azurite.EditorIsolation.Policy.LabOnly.dll</HintPath></Reference>
    <Reference Include="0Harmony" Private="false"><HintPath>$(AAInstallPath)/BepInEx/core/0Harmony.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Runtime" Private="false"><HintPath>$(AAInstallPath)/BepInEx/core/Il2CppInterop.Runtime.dll</HintPath></Reference>
