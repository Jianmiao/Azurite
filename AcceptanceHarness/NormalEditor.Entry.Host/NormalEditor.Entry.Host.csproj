  <Target Name="RequireExplicitHost" BeforeTargets="ResolveReferences"><Error Condition="'$(AAInstallPath)' == '' Or !Exists('$(AAInstallPath)/BepInEx/interop/Assembly-CSharp.dll')" Text="Supply the separately pinned C host compile-input directory through AAInstallPath." /></Target>
</Project>
