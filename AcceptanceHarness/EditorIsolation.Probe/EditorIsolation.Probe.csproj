  <Target Name="RequireExactHost" BeforeTargets="ResolveReferences"><Error Condition="!Exists('$(AAInstallPath)/BepInEx/interop/Assembly-CSharp.dll')" Text="Pass AAInstallPath explicitly; this lab harness never discovers or installs a host." /></Target>
</Project>
