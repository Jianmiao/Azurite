<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net6.0</TargetFramework><AssemblyName>Azurite.EditorIsolation.Probe.LabOnly</AssemblyName><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><CheckEolTargetFramework>false</CheckEolTargetFramework><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <ItemGroup><ProjectReference Include="../EditorIsolation.Policy/EditorIsolation.Policy.csproj" /></ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Core" Private="false"><HintPath>$(AAInstallPath)/BepInEx/core/BepInEx.Core.dll</HintPath></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP" Private="false"><HintPath>$(AAInstallPath)/BepInEx/core/BepInEx.Unity.IL2CPP.dll</HintPath></Reference>
    <Reference Include="0Harmony" Private="false"><HintPath>$(AAInstallPath)/BepInEx/core/0Harmony.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Runtime" Private="false"><HintPath>$(AAInstallPath)/BepInEx/core/Il2CppInterop.Runtime.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp" Private="false"><HintPath>$(AAInstallPath)/BepInEx/interop/Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="Il2Cppmscorlib" Private="false"><HintPath>$(AAInstallPath)/BepInEx/interop/Il2Cppmscorlib.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule" Private="false"><HintPath>$(AAInstallPath)/BepInEx/interop/UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="Unity.Addressables" Private="false"><HintPath>$(AAInstallPath)/BepInEx/interop/Unity.Addressables.dll</HintPath></Reference>
