<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AzuriteCoreMode Condition="'$(AzuriteCoreMode)' == ''">Original</AzuriteCoreMode>
    <AssemblyName>Azurite</AssemblyName>
    <!-- Experimental source-built identity cannot be mistaken for the stable
         Azurite assembly by the existing candidate/package validators. -->
    <AssemblyName Condition="'$(AzuriteCoreMode)' == 'AuthoringSource'">Azurite.AuthoringSource</AssemblyName>
    <DefineConstants Condition="'$(AzuriteCoreMode)' == 'AuthoringSource'">$(DefineConstants);AZURITE_AUTHORING_SOURCE</DefineConstants>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>netcoreapp6.0</TargetFramework>
    <Nullable>annotations</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup />
  <ItemGroup>
    <!-- Historical test fixtures still exercise the retired model; it must not
         ship in the plugin after the native/managed iterator fault. -->
    <Compile Remove="Azurite/ProgressivePreloadEnumerator.cs" />
    <Compile Remove="Azurite/ProgressivePreloadBudget.cs" />
    <Compile Remove="Azurite/ProgressiveEditorGate.cs" />
    <Compile Remove="Azurite/AuthoringCardPackPanel.cs" Condition="'$(AzuriteCoreMode)' != 'AuthoringSource'" />
    <Compile Remove="Azurite/AuthoringCardPackHost*.cs" Condition="'$(AzuriteCoreMode)' != 'AuthoringSource'" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json" Private="false"><HintPath>$(AAInstallPath)\BepInEx\interop\Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="UniTask" Private="false"><HintPath>$(AAInstallPath)\BepInEx\interop\UniTask.dll</HintPath></Reference>
    <Reference Include="spine-unity" Private="false"><HintPath>$(AAInstallPath)\BepInEx\interop\spine-unity.dll</HintPath></Reference>
    <Reference Include="spine-csharp" Private="false"><HintPath>$(AAInstallPath)\BepInEx\interop\spine-csharp.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AnimationModule" Private="false"><HintPath>$(AAInstallPath)\BepInEx\interop\UnityEngine.AnimationModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule" Private="false">
      <HintPath>$(AAInstallPath)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony" Private="false">
      <HintPath>$(AAInstallPath)\BepInEx\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp" Private="false">
      <HintPath>$(AAInstallPath)\BepInEx\interop\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Il2Cppmscorlib" Private="false">
      <HintPath>$(AAInstallPath)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime" Private="false">
      <HintPath>$(AAInstallPath)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule" Private="false">
      <HintPath>$(AAInstallPath)\BepInEx\interop\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Core" Private="false">
      <HintPath>$(AAInstallPath)\BepInEx\core\BepInEx.Core.dll</HintPath>
    </Reference>
    <Reference Include="Unity.RenderPipelines.Universal.Runtime" Private="false">
      <HintPath>$(AAInstallPath)\BepInEx\interop\Unity.RenderPipelines.Universal.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil" Private="false">
      <HintPath>$(AAInstallPath)\BepInEx\core\Mono.Cecil.dll</HintPath>
    </Reference>
    <Reference Include="Azurite.Core" Condition="'$(AzuriteCoreMode)' == 'Original'">
      <HintPath>..\references\Azurite.Core.dll</HintPath>
    </Reference>
    <ProjectReference Include="../Core/Azurite.Core.csproj" Condition="'$(AzuriteCoreMode)' == 'AuthoringSource'" Private="true" />
    <Reference Include="BepInEx.Unity.IL2CPP" Private="false">
      <HintPath>$(AAInstallPath)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
    </Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime" Private="false">
      <HintPath>$(AAInstallPath)\BepInEx\interop\Unity.RenderPipelines.Core.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule" Private="false">
      <HintPath>$(AAInstallPath)\BepInEx\interop\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateAzuriteBuildMode" BeforeTargets="PrepareForBuild;ResolveReferences">
    <Error Condition="'$(AzuriteCoreMode)' != 'Original' and '$(AzuriteCoreMode)' != 'AuthoringSource'" Text="AzuriteCoreMode must be Original or AuthoringSource; no dependency fallback is allowed." />
    <Error Condition="'$(AzuriteCoreMode)' == 'AuthoringSource' and ('$(UseArtifactsOutput)' != 'true' or '$(ArtifactsPath)' == '')" Text="AuthoringSource requires --artifacts-path with a fresh independent output directory (SDK 8+). Use tools/Build-AuthoringSource.ps1." />
    <Error Condition="'$(AzuriteCoreMode)' == 'AuthoringSource' and '$(ArtifactsPath)' != '' and !$([System.IO.Path]::IsPathRooted('$(ArtifactsPath)'))" Text="AuthoringSource requires an absolute artifacts path." />
    <Error Condition="'$(AzuriteCoreMode)' == 'AuthoringSource' and '$(BuildProjectReferences)' == 'false'" Text="AuthoringSource must build its source Core; BuildProjectReferences=false cannot certify the pair." />
  </Target>
  <Target Name="RejectAuthoringPackaging" BeforeTargets="GenerateNuspec;Pack;PrepareForPublish;Publish" Condition="'$(AzuriteCoreMode)' == 'AuthoringSource'">
    <Error Text="AuthoringSource is an isolated experimental build, not a release package. A separately reviewed authoring packaging and runtime acceptance path is required." />
  </Target>
  <Target Name="CheckRecoveredHostReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(AAInstallPath)/BepInEx/interop/Assembly-CSharp.dll')" Text="AAInstallPath must point to an AA installation with generated BepInEx IL2CPP interop assemblies." />
    <Error Condition="'$(AzuriteCoreMode)' == 'Original' and !Exists('$(MSBuildThisFileDirectory)../references/Azurite.Core.dll')" Text="The source bundle must include references/Azurite.Core.dll from the validated Azurite 0.7.0 package." />
  </Target>
  <ItemGroup Condition="'$(AzuriteCoreMode)' == 'AuthoringSource'">
    <Reference Include="UnityEngine.IMGUIModule" Private="false"><HintPath>$(AAInstallPath)\BepInEx\interop\UnityEngine.IMGUIModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
