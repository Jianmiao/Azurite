<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <ShortcutSource Condition="'$(ShortcutSource)' == ''">../Plugin/Azurite/AuthoringSpeakerShortcuts.cs</ShortcutSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ShortcutSource)" Link="Production/AuthoringSpeakerShortcuts.cs" />
    <Compile Include="../Plugin/Azurite/HostProfile.cs" Link="Production/HostProfile.cs" />
  </ItemGroup>
</Project>
